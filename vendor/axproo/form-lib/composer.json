{
    "name": "axproo/form-lib",
    "description": "Bibliothèque de gestion des formulaires dynamique et validation unifiée pour CI4.",
    "type": "library",
    "version": "1.0.1",
    "license": "MIT",
    "authors": [
      {
        "name": "Christian Djomou",
        "email": "contact@axproo.com",
        "homepage": "https://axproo.com"
      }
    ],
    "require": {
      "php": ">=8.1",
      "codeigniter4/framework": "^4.6"
    },
    "autoload": {
      "psr-4": {
        "Axproo\\Form\\": "src/"
      }
    },
    "autoload-dev": {
      "psr-4": {
        "Axproo\\Form\\Tests\\": "tests/"
      }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
      "test": "phpunit"
    },
    "extra": {
      "branch-alias": {
        "dev-main": "1.x-dev"
      }
    },
    "require-dev": {
      "phpunit/phpunit": "^12.4"
    }
  }
