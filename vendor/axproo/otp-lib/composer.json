{
    "name": "axproo/otp-lib",
    "description": "Bibliothèque officielle AXPROO pour la génération, la validation et la gestion des OTP (One-Time Password) et endpoints d’authentification sécurisés.",
    "type": "library",
    "version": "1.0.2",
    "licence": "MIT",
    "authors": [
        {
            "name": "Christian DJOMOU",
            "email": "developer@axproo.com",
            "homepage": "https://axproo.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "axproo/helper-lib": "^1.0",
        "codeigniter4/framework": "^4.5",
        "firebase/php-jwt": "^6.10"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axproo/helper-lib.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "Axproo\\Otp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Axproo\\Otp\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x.dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4"
    },
    "keywords": ["codeigniter4","otp","library","axproo","auth","api"],
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    }
}
