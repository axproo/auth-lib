{
  "name": "axproo/mailer",
  "description": "Service de messagerie universel basé sur CodeIgniter 4.",
  "type": "library",
  "version": "1.0.0",
  "license": "MIT",
  "authors": [
    {
      "name": "Christian Djomou",
      "email": "contact@axproo.com",
      "homepage": "https://axproo.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "codeigniter4/framework": "^4.5"
  },
  "autoload": {
    "psr-4": {
      "Axproo\\Mailer\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Axproo\\Mailer\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.x-dev"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.4"
  }
}