{
  "name": "axproo/auth-lib",
  "description": "Bibliothèque d'authentification complète et réutilisable pour CI4.",
  "type": "library",
  "version": "1.0.9",
  "license": "MIT",
  "authors": [
    {
      "name": "Christian Djomou",
      "email": "contact@axproo.com",
      "homepage": "https://axproo.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "axproo/helper-lib": "^1.0.2",
    "axproo/otp-lib": "^2.0",
    "codeigniter4/framework": "^4.5",
    "firebase/php-jwt": "^6.10",
    "ramsey/uuid": "^4.9"
  },
  "autoload": {
    "psr-4": {
      "Axproo\\Auth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Axproo\\Auth\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "prefer-lowest": false,
    "branch-alias": {
      "dev-main": "1.x-dev"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.90",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.4"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/axproo/otp-lib.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/axproo/mailer.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/axproo/helper-lib.git"
    }
  ],
  "keywords": ["codeigniter4", "auth", "jwt", "library", "axproo"],
  "config": {
    "process-timeout": 0,
    "sort-packages": true
  }
}
